---
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import config from '@/site-config'

const headings = [
  { depth: 2, slug: 'projects', text: 'Projects' }
]
---

<PageLayout title='Projects' {headings} info={{ slug: '/projects', hideComment: true }}>
  <h2 id='projects'>Projects</h2>
  <ProjectSection
    project={[
      {
        name: 'lead-screening-agent',
        description:
          'Lead pre-screening agent (kapibala): three independent LLM calls estimate intent, dissatisfaction and follow-up requests, while a deterministic state machine and truth-table policy pick the single legal action out of four — the LLM estimates, it never decides. Layered defenses: input injection guard, sliding-window rate limiting, action allowlist and output canary checks. 18/18 red-team attacks blocked, 103 tests green.',
        links: [{ type: 'github', href: 'https://github.com/Yandick/lead-screening-agent' }]
      }
    ]}
  />
</PageLayout>

<script
  is:inline
  type='module'
  data-astro-rerun
  define:vars={{ npmCDN: config.npmCDN, walineServer: config.integ.waline.server }}
>
  const normalizePath = (path) => {
    if (path === '/') return path
    return path.endsWith('/') ? path.slice(0, -1) : path
  }

  const loadPageviewCount = async () => {
    const pageview = await import(`${npmCDN}/@waline/client@v3/dist/pageview.js`)
    pageview.pageviewCount({
      serverURL: walineServer,
      path: normalizePath(window.location.pathname)
    })
  }

  await loadPageviewCount()
</script>
