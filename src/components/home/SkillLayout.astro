---
import { Button } from '@/components/user'

const { title, skills } = Astro.props
---

<div class='flex flex-col gap-y-2 md:flex-row md:gap-x-4 md:gap-y-0'>
  <span class='shrink-0 text-sm leading-7 text-muted-foreground md:w-24'>{title}</span>
  <div class='flex flex-row flex-wrap items-center gap-x-2 gap-y-2'>
    {skills.map((skill: string) => <Button as='button' title={skill} style='pill' class='px-3 py-1 text-xs' />)}
  </div>
</div>
